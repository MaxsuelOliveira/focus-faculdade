{
  "name": "focus-faculdade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "portal:inspect": "tsx scripts/inspect-portal.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "browser:install": "playwright install chromium",
    "portal:sync": "tsx scripts/sync-portal.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "checklist:seed": "tsx scripts/seed-pi-checklist.ts",
    "mcp": "node dist/server/mcp-stdio.js",
    "privacy:check": "node scripts/check-public.mjs",
    "portal:assessment": "tsx scripts/inspect-assessment.ts",
    "public:prepare": "node scripts/prepare-public.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxsuelOliveira/focus-faculdade.git"
  },
  "homepage": "https://github.com/MaxsuelOliveira/focus-faculdade",
  "bugs": {
    "url": "https://github.com/MaxsuelOliveira/focus-faculdade/issues"
  }
}
